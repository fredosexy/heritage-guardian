# Public browser configuration. Never add service-role keys or provider secrets here.
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Server-side Edge Function configuration for local/staging setup.
# In hosted Supabase, configure this as an Edge Function secret/environment value.
# Comma-separated exact origins or wildcard host patterns.
APP_ALLOWED_ORIGINS=http://localhost:8080,https://YOUR_PROJECT.lovable.app
