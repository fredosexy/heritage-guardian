# Copy this file to .env.local and provide the public Supabase client configuration.
# Never put service-role keys or Supabase secret keys in VITE_* variables.
VITE_SUPABASE_PROJECT_ID=your-supabase-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co

# Optional MapLibre style URL. The style document must declare its tile sources and attribution.
# Configure a provider you are licensed to use; leave empty to keep manual GPS/coordinate entry only.
VITE_TERRAIN_MAP_STYLE_URL=
